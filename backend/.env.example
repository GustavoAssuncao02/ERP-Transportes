NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Opcional: use HTTPS para evitar bloqueio de download inseguro pelo navegador.
# Os caminhos relativos abaixo partem da pasta backend/.
HTTPS_ENABLED=false
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=erp_transportes
DB_CONNECTION_LIMIT=10

CORS_ORIGIN=http://localhost:5173,http://localhost:5174
